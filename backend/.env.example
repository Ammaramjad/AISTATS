# Backend environment configuration
# Copy this file to `.env` and adjust as needed:  cp .env.example .env

# Human-readable service name (shown in API responses).
APP_NAME=AISTATS API

# Deployment environment: development | staging | production
ENVIRONMENT=development

# Enable verbose/debug behavior.
DEBUG=true

# Comma-separated list of origins allowed to call the API (CORS).
# Add your deployed frontend origin here in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
