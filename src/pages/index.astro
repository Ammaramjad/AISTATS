---
import '../styles/global.css';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content="Fleet OS — considered transport across the city."><title>Fleet OS — Move with intention</title></head>
<body>
  <header><a class="brand" href="/" aria-label="Fleet OS home"><span>F</span> FLEET OS</a><div class="header-note"><i></i> Taipei network active</div><button class="menu" aria-label="Open menu">Menu</button></header>
  <main>
    <section class="hero">
      <div class="scene-wrap"><canvas id="city" aria-label="Interactive route and selected vehicle visualization"></canvas><div id="scene-status" class="scene-status">Preparing live city…</div><div class="scene-label"><small>LIVE ROUTE</small><strong id="scene-title">Airport → Taipei</strong></div></div>
      <div class="booking-shell">
        <div class="eyebrow">PRIVATE MOBILITY · TAIPEI</div><h1>Your city,<br><em>considered.</em></h1><p class="lede">One thoughtful journey from runway to doorway. Choose the service; we’ll shape the route.</p>
        <nav class="steps" aria-label="Booking progress"><button data-goto="1" class="active">01 <span>Journey</span></button><button data-goto="2">02 <span>Vehicle</span></button><button data-goto="3">03 <span>Review</span></button><button data-goto="4">04 <span>Confirm</span></button></nav>
        <div id="message" role="status" aria-live="polite"></div>
        <section class="panel active" data-step="1">
          <label>Service<select id="service"><option value="airport-to-location">Airport → Location</option><option value="location-to-airport">Location → Airport</option><option value="location-to-location">Location → Location</option><option value="self-drive">Self-drive vehicle rental</option><option value="chauffeur">Vehicle with driver / Chauffeur</option></select></label>
          <div class="route-fields"><label>Pickup<select id="pickup"></select></label><div class="route-stem"><i></i></div><label>Destination<select id="destination"></select></label></div>
          <div class="grid"><label>Date<input id="date" type="date"></label><label>Time<input id="time" type="time"></label><label>Passengers<select id="passengers"></select></label><label>Luggage<select id="luggage"></select></label></div>
          <button class="primary" data-next>Explore vehicles <b>→</b></button>
        </section>
        <section class="panel" data-step="2"><div class="panel-heading"><div><small>CURATED FOR THIS ROUTE</small><h2>Choose your vehicle</h2></div><strong id="fare-top"></strong></div><div id="vehicle-list" class="vehicle-list"></div><button class="primary" data-next>Review journey <b>→</b></button></section>
        <section class="panel" data-step="3"><div class="panel-heading"><div><small>EVERY DETAIL, ALIGNED</small><h2>Review your journey</h2></div></div><div id="review" class="review"></div><label id="driver-wrap">Preferred driver<select id="driver"><option>No preference</option><option>Quiet journey</option><option>English-speaking preferred</option></select></label><p class="prototype-note">Prototype estimate only. No payment is collected and no reservation is sent.</p><button class="primary" data-next>Confirm prototype itinerary <b>→</b></button></section>
        <section class="panel" data-step="4"><div class="success-mark">✓</div><small>ITINERARY SAVED LOCALLY</small><h2>Your journey is ready for review.</h2><p class="confirmation-copy">This is an honest product prototype—not a completed reservation. Connect a dispatch and payment backend before accepting bookings.</p><div id="confirmation" class="review"></div><button class="secondary" id="restart">Edit journey</button></section>
      </div>
    </section>
  </main><footer><span>FLEET OS / PRIVATE MOBILITY</span><span>Transparent estimates · No hidden booking</span></footer>
  <script>
    import { createBookingStore } from '../lib/booking-store'; import { places, vehicles, estimateFare } from '../lib/catalog'; import { route, routeDistance } from '../lib/road-network'; import { CityScene } from '../lib/city-scene';
    const $=(s)=>document.querySelector(s); const store=createBookingStore(); let scene;
    const pickup=$('#pickup'),destination=$('#destination'); places.forEach(p=>{pickup.add(new Option(p.name,p.id));destination.add(new Option(p.name,p.id))}); for(let i=1;i<=8;i++)$('#passengers').add(new Option(`${i} passenger${i>1?'s':''}`,i));for(let i=0;i<=8;i++)$('#luggage').add(new Option(`${i} bag${i===1?'':'s'}`,i));
    try{scene=new CityScene($('#city'));$('#scene-status').remove()}catch(e){$('#scene-status').textContent='3D view unavailable — booking remains fully usable.';$('#scene-status').classList.add('error');console.error(e)}
    function setStep(step){store.set({step,status:step===3?'review':step===4?'prototype-confirmed':'editing'});document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',+p.dataset.step===step));document.querySelectorAll('.steps button').forEach((b,i)=>{b.classList.toggle('active',i+1===step);b.classList.toggle('done',i+1<step)});if(innerWidth<700)$('.booking-shell').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})}
    function pathInfo(s){const a=places.find(p=>p.id===s.pickup),b=places.find(p=>p.id===s.destination);const path=a&&b?route(a.node,b.node):[];return {a,b,path,km:routeDistance(path)}}
    store.subscribe(s=>{const {a,b,path,km}=pathInfo(s);const vehicle=vehicles.find(v=>v.id===s.vehicle);pickup.value=s.pickup;destination.value=s.destination;['service','date','time','passengers','luggage','driver'].forEach(id=>{const el=$('#'+id);if(el)el.value=s[id]});$('#scene-title').textContent=`${a?.name??'Pickup'} → ${b?.name??'Destination'}`;scene?.update(s);
      const available=vehicles.filter(v=>v.services.includes(s.service));const compatible=available.filter(v=>v.seats>=s.passengers&&v.bags>=s.luggage);if(!available.some(v=>v.id===s.vehicle)||vehicle.seats<s.passengers||vehicle.bags<s.luggage){if(compatible[0])queueMicrotask(()=>store.set({vehicle:compatible[0].id}));return}$('#vehicle-list').innerHTML=available.map(v=>`<button class="vehicle ${v.id===s.vehicle?'selected':''} ${v.seats<s.passengers||v.bags<s.luggage?'disabled':''}" data-vehicle="${v.id}" ${v.seats<s.passengers||v.bags<s.luggage?'disabled':''}><span class="vehicle-icon ${v.body}"><i></i><b></b></span><span><strong>${v.name}</strong><small>${v.subtitle}</small><em>${v.seats} seats · ${v.bags} bags</em></span><b>NT$ ${estimateFare(km,v,s.service).toLocaleString()}</b></button>`).join('');
      const fare=estimateFare(km,vehicle,s.service);$('#fare-top').textContent=`from NT$ ${fare.toLocaleString()}`;const rows=`<dl><div><dt>From</dt><dd>${a?.name}</dd></div><div><dt>To</dt><dd>${b?.name}</dd></div><div><dt>When</dt><dd>${s.date} · ${s.time}</dd></div><div><dt>Vehicle</dt><dd>${vehicle.name} · ${vehicle.seats} seats / ${vehicle.bags} bags</dd></div><div><dt>Route estimate</dt><dd>${km.toFixed(1)} km · NT$ ${fare.toLocaleString()}</dd></div></dl>`;$('#review').innerHTML=rows;$('#confirmation').innerHTML=rows;$('#driver-wrap').hidden=!['chauffeur','airport-to-location','location-to-airport'].includes(s.service);$('#message').textContent=path.length?'':'That route is currently unavailable.';
    });
    document.addEventListener('change',e=>{const el=e.target;if(!el.id)return;const numeric=['passengers','luggage'].includes(el.id);store.set({[el.id]:numeric?+el.value:el.value});if(['pickup','destination'].includes(el.id)&&pickup.value===destination.value)$('#message').textContent='Pickup and destination must be different.'});
    document.addEventListener('click',e=>{const btn=e.target.closest('button');if(!btn)return;if(btn.dataset.vehicle)store.set({vehicle:btn.dataset.vehicle});if(btn.dataset.next){const s=store.get();if(s.pickup===s.destination){$('#message').textContent='Choose two different locations.';return}setStep(Math.min(4,s.step+1))}if(btn.dataset.goto&&+btn.dataset.goto<=store.get().step)setStep(+btn.dataset.goto);if(btn.id==='restart')setStep(1)});
  </script>
</body></html>
